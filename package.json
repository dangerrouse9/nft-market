{
  "name": "agent-nft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "api": "npm start --workspace packages/marketplace-api",
    "creator": "npm start --workspace packages/creator-agent",
    "buyer": "npm start --workspace packages/buyer-agent",
    "setup": "tsx scripts/setup.ts",
    "register-agents": "tsx scripts/register-agents.ts",
    "fund-wallets": "tsx scripts/fund-wallets.ts",
    "init-config": "tsx scripts/init-config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-nft/shared": "*",
    "@anchor-lang/core": "^1.1.2",
    "@metaplex-foundation/mpl-agent-registry": "^0.2.6",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-uploader-irys": "^1.5.0",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
