# Copy to .env and fill in. Never commit .env.

# ===== Anthropic (console.anthropic.com -> API Keys) =====
ANTHROPIC_API_KEY=

# ===== Solana =====
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# ===== Marketplace program (filled after `anchor deploy`) =====
MARKETPLACE_PROGRAM_ID=

# ===== Agent registry (filled by scripts/register-agents.ts) =====
CREATOR_AGENT_ASSET_ADDRESS=
BUYER_AGENT_ASSET_ADDRESS=

# ===== Wallets (filled by scripts/setup.ts) =====
MARKETPLACE_WALLET_ADDRESS=
KEYS_DIR=.keys

# ===== Marketplace API =====
MARKETPLACE_PORT=3000
MARKETPLACE_URL=http://localhost:3000
MARKETPLACE_FEE_BPS=150
# How often the API re-derives listing status from the chain (seconds)
RECONCILE_SECONDS=45
# Set on Railway to use PostgreSQL instead of the local JSON file
# DATABASE_URL=postgres://...
# Public URL of this API once hosted (used in metadata URIs and market-info)
# MARKETPLACE_PUBLIC_URL=https://your-app.up.railway.app
# Link shown on the frontend for agent integration docs
# DOCS_URL=https://github.com/you/agent-nft/blob/main/docs/INTEGRATE.md

# ===== Creator agent =====
MINT_PRICE_SOL=0.01
MINT_INTERVAL_MINUTES=30
ROYALTY_BPS=1000
RUN_ONCE=false

# ===== Buyer agent =====
BUDGET_SOL=0.05
MAX_PRICE_PER_NFT=0.01
POLL_SECONDS=60

# ===== Claude =====
CLAUDE_MODEL=claude-sonnet-4-6

# ===== Data =====
DATA_DIR=data
